# Ignore environment variables
.env

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore build folders
dist/
build/
rsconnect/
data/*.gz
data/*.tbi
*.Rhistory
.Rproj.user/
brag-output*/*
# Ignore log files
*.log

# --- Manuscript & internal review materials (never push to public mirror) ---
# These contain in-review manuscript drafts, reviewer comments, revision plans,
# and cover-letter responses. Keep local; do not commit to any public remote.
*.docx
*.pdf
docs/
docs/plans/
docs/cover-letter-*.md
# Manuscript-document generation / editing scripts (keep local, never push)
analyses/manuscript_*
analyses/compose_fig1_casr.py
analyses/10_compose_supp_s2.R
# Local backups / large binaries / tooling — never commit
backup/
*.bundle
tectonic
data/*.bak.*
.claude/
.codegraph/
.serena/
varviz-research.md
varviz-humanized-research.md
clinvar_debug_raw.json

# --- Pass 2 analysis artifacts (regeneratable; never push to public mirror) ---
analyses/raw/
analyses/derived/
analyses/classifications/
analyses/figures/
analyses/reports/
analyses/tmp/
# Keep tracked: analyses/*.R, analyses/lib/*.R, analyses/manifests/*.json

# AlphaMissense per-substitution CSVs cached at the project root by the
# harness (one per UniProt accession; tens of thousands of rows each).
# Regeneratable from https://alphafold.ebi.ac.uk/files/AF-<UID>-F1-aa-substitutions.csv
[A-Z][0-9]*-F1-aa-substitutions.csv
server.R.bak.*

# Lazy-load stores (large, regeneratable via analyses/26_build_varviz_sqlite.R)
data/*.sqlite
data/pfam_pssm_human_deploy.rds

# Benchmark run outputs, out-of-band API caches, and raw archives.
# Large and regeneratable; the harness + server.R that produce them are tracked.
# Trailing slashes so analyses/ps_*_harness.R stays tracked.
analyses/ps_*/
analyses/cache/
analyses/raw_archive/
analyses/repro/out/
*.bak.20*

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Analysis run outputs live outside the repo; only the code that makes them is tracked.
analyses/ras_vcep_*/

# Manuscript sources: prose destined for a journal, never published from this repo
# (see rules/common/publishing.md). docs/ is already ignored above.
analyses/humu/

# Superseded external-validation outputs. The current cohort is external163_v231,
# which goes to the Zenodo deposit rather than here; keeping both invited picking
# up the older one by mistake.
analyses/external_validation/

# Zenodo deposit staging (106 MB). Built from the run outputs by the scripts in
# analyses/; it goes to Zenodo, not here, and mirroring it would duplicate every
# classification twice over.
analyses/zenodo_deposit/

# Archived and intermediate run outputs. Same rule as analyses/ps_*/ above: the
# code that produces them is tracked, the outputs are not.
analyses/runs_archive_*/
analyses/weekly_test/
analyses/external163_v231/

# Another group's source data, fetched from the Code Ocean capsule cited in
# Supplementary §S4. It is CC0 and is redistributed in the Zenodo deposit as
# inputs/ghasemnejad2026_tool_outputs.csv, which is where it belongs: 2.8 MB of
# someone else's tool outputs is deposit material, not repository material.
analyses/ACMG_163new.csv

# Local tooling config, machine-specific.
.mcp.json
.ignore
__pycache__/

# Manuscript-reading tooling: stays local, never published.
# These read analyses/humu/*.md or the built .docx; the publishing policy
# excludes scripts that read or narrate the manuscript.
analyses/validate_manuscript_citations.py
analyses/verify_manuscript_numbers.py
analyses/build_tables_s5_s6.py
analyses/validate_table_rendering.py
analyses/OPTION_C_HANDOFF.md
